@page "/api/{TypeSlug}"

@if (_typeInfo is not null)
{
    <Breadcrumb Section="api" PageName="@_typeInfo.Name"
                ExamplesUrl="@_examplesUrl" />
    <ApiDoc TypeInfo="@_typeInfo" />
}
else
{
    <h1>Type not found</h1>
    <p>No API documentation available for <code>@TypeSlug</code>.</p>
}

@code {
    [Parameter]
    public string TypeSlug { get; set; } = "";

    private ApiTypeInfo? _typeInfo;
    private string? _examplesUrl;

    private static readonly Dictionary<string, string> _examplesUrls = new()
    {
        ["Spillgebees.Blazor.Docs.Sdk.DocSite"] = "components/doc-site",
        ["Spillgebees.Blazor.Docs.Sdk.ExampleView`1"] = "components/example-view",
        ["Spillgebees.Blazor.Docs.Sdk.CodeBlock"] = "components/code-block",
        ["Spillgebees.Blazor.Docs.Sdk.ApiDoc"] = "components/api-doc",
        ["Spillgebees.Blazor.Docs.Sdk.ThemeToggle"] = "components/theme-toggle",
    };

    protected override void OnParametersSet()
    {
        _typeInfo = ApiReferenceNav.FindType<DocSite>(TypeSlug);
        _examplesUrl = null;
        if (_typeInfo is not null)
        {
            _examplesUrls.TryGetValue(_typeInfo.Id, out _examplesUrl);
        }
    }
}
