@namespace Spillgebees.Blazor.Docs.Sdk
@using Microsoft.AspNetCore.Components
@using Microsoft.JSInterop
@using System.Linq
@using System.Text.RegularExpressions
@inject IJSRuntime JS

@if (TypeInfo is not null)
{
    <article class="api-doc">
        <header class="api-doc-header">
            <h2 class="api-doc-type-name">@TypeInfo.Name</h2>
            <div class="api-doc-meta">
                <span class="api-doc-namespace">@TypeInfo.Namespace</span>
                <span class="api-doc-kind-badge">@TypeInfo.Kind</span>
            </div>
        </header>

        @if (!string.IsNullOrEmpty(TypeInfo.Summary))
        {
            <div class="api-doc-summary api-doc-rich-text">@RenderDocumentation(TypeInfo.Summary, TypeInfo.SummaryHtml)</div>
        }
        @if (!string.IsNullOrEmpty(TypeInfo.Remarks))
        {
            <div class="api-doc-summary api-doc-rich-text">@RenderDocumentation(TypeInfo.Remarks, TypeInfo.RemarksHtml)</div>
        }

        @if (!string.IsNullOrEmpty(TypeInfo.BaseType) || TypeInfo.Interfaces.Count > 0)
        {
            <section class="api-doc-inheritance">
                <h3>Inheritance</h3>
                @if (!string.IsNullOrEmpty(TypeInfo.BaseType))
                {
                    <div class="api-doc-base-type">
                        <span>Base type: </span><code title="@TypeInfo.BaseType">@ShortenTypeName(TypeInfo.BaseType)</code>
                    </div>
                }
                @if (TypeInfo.Interfaces.Count > 0)
                {
                    <div class="api-doc-interfaces">
                        <span>Implements: </span>
                        @foreach (var iface in TypeInfo.Interfaces)
                        {
                            <code title="@iface">@ShortenTypeName(iface)</code>
                        }
                    </div>
                }
            </section>
        }

        @if (TypeInfo.GenericParameters.Count > 0)
        {
            <section class="api-doc-generic-parameters">
                <h3>Type Parameters</h3>
                <ul>
                    @foreach (var param in TypeInfo.GenericParameters)
                    {
                        <li>
                            <code>@param.Name</code>
                            @if (param.Constraints.Count > 0)
                            {
                                <span> where </span>
                                @foreach (var constraint in param.Constraints)
                                {
                                    <code title="@constraint">@ShortenTypeName(constraint)</code>
                                }
                            }
                        </li>
                    }
                </ul>
            </section>
        }

        @if (TypeInfo.Properties.Count > 0)
        {
            <section class="api-doc-section">
                <button class="api-doc-section-toggle" @onclick="@(() => ToggleSection("properties"))">
                    // properties <span class="api-doc-section-indicator">@(IsSectionOpen("properties") ? "−" : "+")</span>
                </button>
                @if (IsSectionOpen("properties"))
                {
                    <div class="api-doc-definitions">
                        @foreach (var prop in TypeInfo.Properties)
                        {
                            <div class="api-doc-definition">
                                <div class="api-doc-definition-name">@prop.Name</div>
                                <div class="api-doc-definition-meta">
                                    <span class="api-doc-definition-type" title="@prop.Type">@ShortenTypeName(prop.Type)</span>
                                    @if (prop.IsParameter)
                                    {
                                        <span class="api-doc-badge-required">blazor parameter</span>
                                    }
                                    @if (prop.IsCascadingParameter)
                                    {
                                        <span class="api-doc-badge-required">cascading parameter</span>
                                    }
                                    @if (prop.DefaultValue is not null)
                                    {
                                        <span class="api-doc-default-value">= @prop.DefaultValue</span>
                                    }
                                </div>
                                @if (!string.IsNullOrEmpty(prop.Summary))
                                {
                                    <div class="api-doc-definition-desc api-doc-rich-text">@RenderDocumentation(prop.Summary, prop.SummaryHtml)</div>
                                }
                            </div>
                        }
                    </div>
                }
            </section>
        }

        @if (TypeInfo.Methods.Count > 0)
        {
            <section class="api-doc-section">
                <button class="api-doc-section-toggle" @onclick="@(() => ToggleSection("methods"))">
                    // methods <span class="api-doc-section-indicator">@(IsSectionOpen("methods") ? "−" : "+")</span>
                </button>
                @if (IsSectionOpen("methods"))
                {
                    <div class="api-doc-definitions">
                        @foreach (var method in TypeInfo.Methods)
                        {
                            var genericParameters = method.GenericParameters.Count == 0
                                ? ""
                                : $"<{string.Join(", ", method.GenericParameters.Select(p => p.Name))}>";
                            var parameterList = string.Join(", ", method.Parameters.Select(p => FormatParameter(p, shortenTypes: true)));
                            var constraints = method.GenericParameters.Count == 0
                                ? ""
                                : " " + string.Join(" ", method.GenericParameters
                                    .Where(p => p.Constraints.Count > 0)
                                    .Select(p => $"where {p.Name} : {string.Join(", ", p.Constraints.Select(ShortenTypeName))}"));
                            var sig = $"{ShortenTypeName(method.ReturnType)} {method.Name}{genericParameters}({parameterList}){constraints}";
                            var fullSig = $"{method.ReturnType} {method.Name}{genericParameters}({string.Join(", ", method.Parameters.Select(p => FormatParameter(p, shortenTypes: false)))})";
                            <div class="api-doc-definition api-doc-method-def">
                                <div class="api-doc-method-signature">
                                    <pre title="@fullSig"><code class="language-csharp">@sig</code></pre>
                                </div>
                                @if (!string.IsNullOrEmpty(method.Summary))
                                {
                                    <div class="api-doc-definition-desc api-doc-rich-text">@RenderDocumentation(method.Summary, method.SummaryHtml)</div>
                                }
                                @foreach (var parameter in method.Parameters.Where(p => !string.IsNullOrEmpty(p.Summary)))
                                {
                                    <div class="api-doc-definition-desc api-doc-rich-text"><code>@parameter.Name</code> @RenderDocumentation(parameter.Summary, parameter.SummaryHtml)</div>
                                }
                            </div>
                        }
                    </div>
                }
            </section>
        }

        @if (TypeInfo.Events.Count > 0)
        {
            <section class="api-doc-section">
                <button class="api-doc-section-toggle" @onclick="@(() => ToggleSection("events"))">
                    // events <span class="api-doc-section-indicator">@(IsSectionOpen("events") ? "−" : "+")</span>
                </button>
                @if (IsSectionOpen("events"))
                {
                    <div class="api-doc-definitions">
                        @foreach (var evt in TypeInfo.Events)
                        {
                            <div class="api-doc-definition">
                                <div class="api-doc-definition-name">@evt.Name</div>
                                <div class="api-doc-definition-meta">
                                    <span class="api-doc-definition-type" title="@evt.Type">@ShortenTypeName(evt.Type)</span>
                                </div>
                                @if (!string.IsNullOrEmpty(evt.Summary))
                                {
                                    <div class="api-doc-definition-desc api-doc-rich-text">@RenderDocumentation(evt.Summary, evt.SummaryHtml)</div>
                                }
                            </div>
                        }
                    </div>
                }
            </section>
        }

        @if (TypeInfo.EnumValues.Count > 0)
        {
            <section class="api-doc-enum-values">
                <h3>Values</h3>
                <table class="api-doc-table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Value</th>
                            <th>Summary</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var enumVal in TypeInfo.EnumValues)
                        {
                            <tr>
                                <td>@enumVal.Name</td>
                                <td>@enumVal.Value</td>
                                <td class="api-doc-rich-text">@RenderDocumentation(enumVal.Summary, enumVal.SummaryHtml)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </section>
        }
    </article>
}

@code {
    [Parameter]
    public ApiTypeInfo? TypeInfo { get; set; }

    [Parameter]
    public Type? Type { get; set; }

    private readonly HashSet<string> _collapsedSections = [];
    private static readonly Regex _fullyQualifiedTypeNameRegex = new(
        @"[A-Za-z_][A-Za-z0-9_]*(?:\.[A-Za-z_][A-Za-z0-9_]*)+",
        RegexOptions.Compiled);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("Spillgebees.DocsSdk.highlightAll");
    }

    protected override void OnParametersSet()
    {
        if (TypeInfo is not null || Type is null) return;

        var assemblyName = Type.Assembly.GetName().Name;
        if (assemblyName is null) return;

        var manifest = EmbeddedResourceLocator.LoadApiManifest(assemblyName, Type.Assembly);
        TypeInfo = manifest is null ? null : ApiReferenceNav.FindType(manifest, Type.FullName ?? Type.Name);
    }

    private void ToggleSection(string sectionName)
    {
        if (!_collapsedSections.Add(sectionName))
        {
            _collapsedSections.Remove(sectionName);
        }
    }

    private bool IsSectionOpen(string sectionName) => !_collapsedSections.Contains(sectionName);

    private static string FormatParameter(ApiParameterInfo parameter, bool shortenTypes)
    {
        var parameterType = shortenTypes ? ShortenTypeName(parameter.Type) : parameter.Type;
        var signature = $"{parameterType} {parameter.Name}";
        if (parameter.DefaultValue is not null)
        {
            signature += " = " + parameter.DefaultValue;
        }

        return signature;
    }

    private static string ShortenTypeName(string? typeName)
    {
        if (string.IsNullOrWhiteSpace(typeName))
        {
            return string.Empty;
        }

        return _fullyQualifiedTypeNameRegex.Replace(typeName, match =>
        {
            var value = match.Value;
            var lastDotIndex = value.LastIndexOf('.');
            return lastDotIndex < 0 ? value : value[(lastDotIndex + 1)..];
        });
    }

    private static MarkupString RenderDocumentation(string? text, string? html) =>
        new(html ?? System.Net.WebUtility.HtmlEncode(text ?? string.Empty));
}
